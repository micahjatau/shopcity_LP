generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TenantStatus {
  ACTIVE
  SUSPENDED
}

enum BranchStatus {
  ACTIVE
  INACTIVE
}

enum DeviceStatus {
  ACTIVE
  INACTIVE
}

enum UserRole {
  CASHIER
  SUPERVISOR
  ADMIN
  SYSTEM
}

enum UserStatus {
  ACTIVE
  DISABLED
  SUSPENDED
}

enum CustomerStatus {
  ACTIVE
  BLOCKED
}

enum CardStatus {
  ACTIVE
  BLOCKED
  REPLACED
}

enum SessionStatus {
  ACTIVE
  REVOKED
  EXPIRED
}

enum IdempotencyRecordStatus {
  PENDING
  COMPLETED
}

enum ReceiptCaptureStatus {
  CAPTURED
  FLAGGED
  PENDING_APPROVAL
}

enum ReceiptReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

enum LedgerEntryStatus {
  CONFIRMED
}

enum LedgerEntryType {
  EARN
  REDEEM
  REVERSAL
  ADJUSTMENT
}

enum LedgerEntryDirection {
  CREDIT
  DEBIT
}

enum ApprovalStatus {
  PENDING
  APPROVED
  EXECUTED
  REJECTED
  EXPIRED
}

enum RedemptionStatus {
  PENDING_APPROVAL
  CONFIRMED
  REJECTED
  EXPIRED
  REVERSED
}

enum AdjustmentKind {
  CREDIT
  DEBIT
}

enum ApprovalTargetType {
  EARN
  REDEEM
}

enum OutboxEventStatus {
  PENDING
  QUEUED
  PUBLISHED
  FAILED
}

enum SmsMessageStatus {
  QUEUED
  SENT
  DELIVERED
  FAILED
  SUPPRESSED
}

model Tenant {
  id                     String                  @id @default(uuid())
  name                   String
  status                 TenantStatus            @default(ACTIVE)
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
  branches               Branch[]
  devices                Device[]
  users                  User[]
  customers              Customer[]
  cards                  Card[]
  receipts               Receipt[]
  ledgerEntries          LoyaltyLedgerEntry[]
  creditLots             CreditLot[]
  redemptions            Redemption[]
  redemptionAllocations  RedemptionAllocation[]
  allocationRestorations AllocationRestoration[]
  adjustments            Adjustment[]
  approvals              Approval[]
  outboxEvents           OutboxEvent[]
  smsMessages            SmsMessage[]
  idempotencyRecords     IdempotencyRecord[]
  auditLogs              AuditLog[]
  deviceAttestations     DeviceAttestation[]
}

model Branch {
  id                  String       @id @default(uuid())
  tenantId            String
  name                String
  timezone            String       @default("Africa/Lagos")
  receiptWeekStartDay Int          @default(1)
  status              BranchStatus @default(ACTIVE)
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt
  tenant              Tenant       @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  devices             Device[]
  users               User[]
  customers           Customer[]
  receipts            Receipt[]
  redemptions         Redemption[]

  @@unique([tenantId, id])
  @@index([tenantId])
}

model Device {
  id                String              @id @default(uuid())
  tenantId          String
  branchId          String
  name              String
  fingerprintHash   String              @unique
  attestationSecretCiphertext String?
  status            DeviceStatus        @default(ACTIVE)
  lastSeenAt        DateTime?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  tenant            Tenant              @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  branch            Branch              @relation(fields: [tenantId, branchId], references: [tenantId, id], onDelete: Restrict)
  sessions          Session[]
  attestationNonces DeviceAttestation[]
  receipts          Receipt[]
  redemptions       Redemption[]

  @@unique([tenantId, id])
  @@unique([tenantId, branchId, id])
  @@index([tenantId, branchId])
}

model User {
  id                   String               @id @default(uuid())
  tenantId             String
  branchId             String?
  username             String
  supabaseAuthId       String?              @unique
  role                 UserRole
  status               UserStatus           @default(ACTIVE)
  lastLoginAt          DateTime?
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt
  tenant               Tenant               @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  branch               Branch?              @relation(fields: [tenantId, branchId], references: [tenantId, id], onDelete: Restrict)
  sessions             Session[]
  registeredCustomers  Customer[]           @relation("CustomerRegisteredBy")
  cardsIssued          Card[]               @relation("CardIssuedBy")
  receiptsCaptured     Receipt[]            @relation("ReceiptCapturedBy")
  receiptsReviewed     Receipt[]            @relation("ReceiptReviewedBy")
  receiptsApproved     Receipt[]            @relation("ReceiptApprovedBy")
  approvalsRequested   Approval[]           @relation("ApprovalRequestedBy")
  approvalsDecided     Approval[]           @relation("ApprovalDecisionBy")
  ledgerEntriesCreated LoyaltyLedgerEntry[] @relation("LoyaltyLedgerEntryCreatedBy")
  redemptionsRequested Redemption[]         @relation("RedemptionRequestedBy")
  adjustmentsCreated   Adjustment[]         @relation("AdjustmentCreatedBy")
  auditLogs            AuditLog[]

  @@unique([tenantId, username])
  @@unique([tenantId, id])
  @@index([tenantId, role])
}

model Session {
  id               String        @id @default(uuid())
  userId           String
  deviceId         String?
  sessionTokenHash String        @unique
  csrfTokenHash    String
  status           SessionStatus @default(ACTIVE)
  expiresAt        DateTime
  revokedAt        DateTime?
  lastUsedAt       DateTime?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  user             User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  device           Device?       @relation(fields: [deviceId], references: [id], onDelete: Restrict)

  @@index([userId, status])
  @@index([deviceId])
}

model DeviceAttestation {
  id                   String   @id @default(uuid())
  tenantId             String
  deviceId             String
  nonce                String
  nonceHash            String?
  attestationTimestamp DateTime?
  acceptedAt           DateTime @default(now())
  expiresAt            DateTime
  issuedSessionId      String?
  createdAt            DateTime @default(now())
  tenant               Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  device               Device   @relation(fields: [tenantId, deviceId], references: [tenantId, id], onDelete: Cascade)

  @@unique([tenantId, deviceId, nonce])
  @@unique([tenantId, deviceId, nonceHash])
  @@index([expiresAt])
  @@index([tenantId, deviceId])
  @@index([issuedSessionId])
}

model Customer {
  id                   String               @id @default(uuid())
  tenantId             String
  branchId             String
  fullName             String
  email                String?
  phoneE164            String
  isStaff              Boolean              @default(false)
  status               CustomerStatus       @default(ACTIVE)
  registeredBy         String?
  registeredByTenantId String?
  blockedAt            DateTime?
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt
  tenant               Tenant               @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  branch               Branch               @relation(fields: [tenantId, branchId], references: [tenantId, id], onDelete: Restrict)
  registeredByUser     User?                @relation("CustomerRegisteredBy", fields: [registeredByTenantId, registeredBy], references: [tenantId, id], onDelete: SetNull)
  cards                Card[]
  receipts             Receipt[]
  ledgerEntries        LoyaltyLedgerEntry[]
  creditLots           CreditLot[]
  redemptions          Redemption[]
  adjustments          Adjustment[]

  @@unique([tenantId, phoneE164])
  @@unique([tenantId, email])
  @@unique([tenantId, id])
  @@index([tenantId, status])
  @@index([registeredByTenantId, registeredBy])
}

model Card {
  id               String       @id @default(uuid())
  tenantId         String
  customerId       String
  barcodeValue     String
  status           CardStatus   @default(ACTIVE)
  issuedBy         String?
  issuedByTenantId String?
  issuedAt         DateTime     @default(now())
  blockedAt        DateTime?
  replacedByCardId String?      @unique
  replacedAt       DateTime?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  tenant           Tenant       @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  customer         Customer     @relation(fields: [tenantId, customerId], references: [tenantId, id], onDelete: Restrict)
  issuedByUser     User?        @relation("CardIssuedBy", fields: [issuedByTenantId, issuedBy], references: [tenantId, id], onDelete: SetNull)
  replacedByCard   Card?        @relation("CardReplacement", fields: [tenantId, replacedByCardId], references: [tenantId, id], onDelete: Restrict)
  replacedCards    Card[]       @relation("CardReplacement")
  receipts         Receipt[]
  redemptions      Redemption[]

  @@unique([tenantId, barcodeValue])
  @@unique([tenantId, id])
  @@index([tenantId, customerId, status])
}

model Receipt {
  id                         String               @id @default(uuid())
  tenantId                   String
  branchId                   String
  customerId                 String
  cardId                     String
  deviceId                   String?
  posReceiptNumber           String
  normalizedPosReceiptNumber String
  receiptWeekStart           DateTime
  purchaseAmountKobo         BigInt
  occurredAt                 DateTime
  capturedByTenantId         String
  capturedBy                 String
  captureStatus              ReceiptCaptureStatus @default(CAPTURED)
  reviewStatus               ReceiptReviewStatus  @default(APPROVED)
  approvalReasonCode         String?
  reviewedAt                 DateTime?
  reviewedByTenantId         String?
  reviewedBy                 String?
  approvedByTenantId         String?
  approvedBy                 String?
  approvedAt                 DateTime?
  capturedAt                 DateTime             @default(now())
  createdAt                  DateTime             @default(now())
  updatedAt                  DateTime             @updatedAt
  tenant                     Tenant               @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  branch                     Branch               @relation(fields: [tenantId, branchId], references: [tenantId, id], onDelete: Restrict)
  customer                   Customer             @relation(fields: [tenantId, customerId], references: [tenantId, id], onDelete: Restrict)
  card                       Card                 @relation(fields: [tenantId, cardId], references: [tenantId, id], onDelete: Restrict)
  device                     Device?              @relation(fields: [tenantId, branchId, deviceId], references: [tenantId, branchId, id], onDelete: Restrict)
  capturedByUser             User                 @relation("ReceiptCapturedBy", fields: [capturedByTenantId, capturedBy], references: [tenantId, id], onDelete: Restrict)
  reviewedByUser             User?                @relation("ReceiptReviewedBy", fields: [reviewedByTenantId, reviewedBy], references: [tenantId, id], onDelete: SetNull)
  approvedByUser             User?                @relation("ReceiptApprovedBy", fields: [approvedByTenantId, approvedBy], references: [tenantId, id], onDelete: SetNull)
  ledgerEntries              LoyaltyLedgerEntry[]
  approvals                  Approval[]
  smsMessages                SmsMessage[]
  redemption                 Redemption?

  @@unique([tenantId, branchId, receiptWeekStart, normalizedPosReceiptNumber])
  @@unique([tenantId, id])
  @@index([tenantId, branchId, receiptWeekStart])
  @@index([tenantId, cardId, occurredAt])
  @@index([capturedByTenantId, capturedBy])
  @@index([reviewedByTenantId, reviewedBy])
  @@index([approvedByTenantId, approvedBy])
}

model LoyaltyLedgerEntry {
  id                     String                  @id @default(uuid())
  tenantId               String
  customerId             String
  receiptId              String?                 @unique
  type                   LedgerEntryType
  direction              LedgerEntryDirection
  amountKobo             BigInt
  status                 LedgerEntryStatus       @default(CONFIRMED)
  correlationId          String                  @unique
  reversesEntryId        String?                 @unique
  createdByTenantId      String
  createdBy              String
  effectiveAt            DateTime
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
  tenant                 Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  customer               Customer                @relation(fields: [tenantId, customerId], references: [tenantId, id], onDelete: Restrict)
  receipt                Receipt?                @relation(fields: [tenantId, receiptId], references: [tenantId, id], onDelete: Restrict)
  createdByUser          User                    @relation("LoyaltyLedgerEntryCreatedBy", fields: [createdByTenantId, createdBy], references: [tenantId, id], onDelete: Restrict)
  reversesEntry          LoyaltyLedgerEntry?     @relation("LedgerReversal", fields: [tenantId, reversesEntryId], references: [tenantId, id], onDelete: Restrict)
  reversedByEntries      LoyaltyLedgerEntry[]    @relation("LedgerReversal")
  creditLot              CreditLot?
  redemption             Redemption?             @relation("RedemptionLedgerEntry")
  adjustment             Adjustment?             @relation("AdjustmentLedgerEntry")
  redemptionAllocations  RedemptionAllocation[]  @relation("RedemptionAllocationLedgerEntry")
  allocationRestorations AllocationRestoration[] @relation("AllocationRestorationReversalLedgerEntry")
  smsMessages            SmsMessage[]

  @@unique([tenantId, id])
  @@index([tenantId, customerId, effectiveAt])
  @@index([tenantId, createdAt])
  @@index([createdByTenantId, createdBy])
}

model CreditLot {
  id                    String                 @id @default(uuid())
  tenantId              String
  customerId            String
  earnLedgerEntryId     String                 @unique
  originalAmountKobo    BigInt
  remainingAmountKobo   BigInt
  earnedAt              DateTime
  expiresAt             DateTime
  createdAt             DateTime               @default(now())
  tenant                Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  customer              Customer               @relation(fields: [tenantId, customerId], references: [tenantId, id], onDelete: Restrict)
  earnLedgerEntry       LoyaltyLedgerEntry     @relation(fields: [tenantId, earnLedgerEntryId], references: [tenantId, id], onDelete: Restrict)
  redemptionAllocations RedemptionAllocation[]

  @@unique([tenantId, id])
  @@unique([tenantId, earnLedgerEntryId])
  @@index([tenantId, customerId, expiresAt])
}

model Redemption {
  id                  String                 @id @default(uuid())
  tenantId            String
  branchId            String
  customerId          String
  cardId              String
  deviceId            String
  receiptId           String                 @unique
  requestedByTenantId String
  requestedBy         String
  requestedAmountKobo BigInt
  basketAmountKobo    BigInt
  maximumAllowedKobo  BigInt
  confirmedAmountKobo BigInt?
  status              RedemptionStatus
  policyVersion       String
  ledgerEntryId       String?                @unique
  requestedAt         DateTime               @default(now())
  confirmedAt         DateTime?
  rejectedAt          DateTime?
  reversedAt          DateTime?
  createdAt           DateTime               @default(now())
  updatedAt           DateTime               @updatedAt
  tenant              Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  branch              Branch                 @relation(fields: [tenantId, branchId], references: [tenantId, id], onDelete: Restrict)
  customer            Customer               @relation(fields: [tenantId, customerId], references: [tenantId, id], onDelete: Restrict)
  card                Card                   @relation(fields: [tenantId, cardId], references: [tenantId, id], onDelete: Restrict)
  device              Device                 @relation(fields: [tenantId, branchId, deviceId], references: [tenantId, branchId, id], onDelete: Restrict)
  receipt             Receipt                @relation(fields: [tenantId, receiptId], references: [tenantId, id], onDelete: Restrict)
  requestedByUser     User                   @relation("RedemptionRequestedBy", fields: [requestedByTenantId, requestedBy], references: [tenantId, id], onDelete: Restrict)
  ledgerEntry         LoyaltyLedgerEntry?    @relation("RedemptionLedgerEntry", fields: [tenantId, ledgerEntryId], references: [tenantId, id], onDelete: Restrict)
  allocations         RedemptionAllocation[]
  approval            Approval?
  smsMessages         SmsMessage[]

  @@unique([tenantId, id])
  @@unique([tenantId, receiptId])
  @@unique([tenantId, ledgerEntryId])
  @@index([tenantId, customerId, requestedAt])
  @@index([tenantId, status, requestedAt])
}

model RedemptionAllocation {
  id                      String                  @id @default(uuid())
  tenantId                String
  redemptionId            String?
  adjustmentId            String?
  redemptionLedgerEntryId String
  creditLotId             String
  amountKobo              BigInt
  allocationOrder         Int
  createdAt               DateTime                @default(now())
  tenant                  Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  redemption              Redemption?             @relation(fields: [tenantId, redemptionId], references: [tenantId, id], onDelete: Restrict)
  adjustment              Adjustment?             @relation(fields: [tenantId, adjustmentId], references: [tenantId, id], onDelete: Restrict)
  redemptionLedgerEntry   LoyaltyLedgerEntry      @relation("RedemptionAllocationLedgerEntry", fields: [tenantId, redemptionLedgerEntryId], references: [tenantId, id], onDelete: Restrict)
  creditLot               CreditLot               @relation(fields: [tenantId, creditLotId], references: [tenantId, id], onDelete: Restrict)
  restorations            AllocationRestoration[]

  @@unique([tenantId, id])
  @@unique([tenantId, redemptionId, creditLotId])
  @@unique([tenantId, redemptionId, allocationOrder])
  @@unique([tenantId, adjustmentId, creditLotId])
  @@unique([tenantId, adjustmentId, allocationOrder])
  @@index([tenantId, adjustmentId])
  @@index([tenantId, creditLotId])
  @@index([tenantId, redemptionLedgerEntryId])
}

model AllocationRestoration {
  id                    String               @id @default(uuid())
  tenantId              String
  allocationId          String
  reversalLedgerEntryId String
  amountKobo            BigInt
  createdAt             DateTime             @default(now())
  tenant                Tenant               @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  allocation            RedemptionAllocation @relation(fields: [tenantId, allocationId], references: [tenantId, id], onDelete: Restrict)
  reversalLedgerEntry   LoyaltyLedgerEntry   @relation("AllocationRestorationReversalLedgerEntry", fields: [tenantId, reversalLedgerEntryId], references: [tenantId, id], onDelete: Restrict)

  @@unique([tenantId, id])
  @@unique([tenantId, allocationId, reversalLedgerEntryId])
  @@index([tenantId, reversalLedgerEntryId])
}

model Adjustment {
  id                String                 @id @default(uuid())
  tenantId          String
  customerId        String
  kind              AdjustmentKind
  amountKobo        BigInt
  reason            String
  createdByTenantId String
  createdBy         String
  ledgerEntryId     String                 @unique
  effectiveAt       DateTime
  createdAt         DateTime               @default(now())
  tenant            Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  customer          Customer               @relation(fields: [tenantId, customerId], references: [tenantId, id], onDelete: Restrict)
  createdByUser     User                   @relation("AdjustmentCreatedBy", fields: [createdByTenantId, createdBy], references: [tenantId, id], onDelete: Restrict)
  ledgerEntry       LoyaltyLedgerEntry     @relation("AdjustmentLedgerEntry", fields: [tenantId, ledgerEntryId], references: [tenantId, id], onDelete: Restrict)
  allocations       RedemptionAllocation[]
  smsMessages       SmsMessage[]

  @@unique([tenantId, id])
  @@unique([tenantId, ledgerEntryId])
  @@index([tenantId, customerId, effectiveAt])
}

model Approval {
  id                  String             @id @default(uuid())
  tenantId            String
  receiptId           String?            @unique
  redemptionId        String?            @unique
  targetType          ApprovalTargetType
  status              ApprovalStatus     @default(PENDING)
  requestedByTenantId String
  requestedBy         String
  reasonCode          String?
  policyVersion       String
  expiresAt           DateTime
  decisionByTenantId  String?
  decisionBy          String?
  decisionReason      String?
  requestedAt         DateTime           @default(now())
  decidedAt           DateTime?
  executedAt          DateTime?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
  tenant              Tenant             @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  receipt             Receipt?           @relation(fields: [tenantId, receiptId], references: [tenantId, id], onDelete: Restrict)
  redemption          Redemption?        @relation(fields: [tenantId, redemptionId], references: [tenantId, id], onDelete: Restrict)
  requestedByUser     User               @relation("ApprovalRequestedBy", fields: [requestedByTenantId, requestedBy], references: [tenantId, id], onDelete: Restrict)
  decisionByUser      User?              @relation("ApprovalDecisionBy", fields: [decisionByTenantId, decisionBy], references: [tenantId, id], onDelete: SetNull)

  @@unique([tenantId, redemptionId])
  @@index([tenantId, status, requestedAt])
  @@index([status, expiresAt, requestedAt, id])
  @@index([requestedByTenantId, requestedBy])
  @@index([decisionByTenantId, decisionBy])
}

model OutboxEvent {
  id              String            @id @default(uuid())
  tenantId        String
  aggregateType   String
  aggregateId     String
  eventType       String
  payload         Json
  status          OutboxEventStatus @default(PENDING)
  attempts        Int               @default(0)
  nextAttemptAt   DateTime?
  publishedAt     DateTime?
  deadLetteredAt  DateTime?
  failureCategory String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  tenant          Tenant            @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  smsMessage      SmsMessage?

  @@unique([tenantId, id])
  @@index([tenantId, status, nextAttemptAt])
}

model SmsMessage {
  id                String              @id @default(uuid())
  tenantId          String
  receiptId         String?
  outboxEventId     String
  ledgerEntryId     String?
  redemptionId      String?
  adjustmentId      String?
  phoneE164         String
  template          String
  payload           Json
  status            SmsMessageStatus    @default(QUEUED)
  attempts          Int                 @default(0)
  providerMessageId String?
  lastError         String?
  queuedAt          DateTime            @default(now())
  lastAttemptAt     DateTime?
  nextAttemptAt     DateTime?
  deadLetteredAt    DateTime?
  failureCategory   String?
  sentAt            DateTime?
  deliveredAt       DateTime?
  failedAt          DateTime?
  suppressedAt      DateTime?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  tenant            Tenant              @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  receipt           Receipt?            @relation(fields: [tenantId, receiptId], references: [tenantId, id], onDelete: Restrict)
  outboxEvent       OutboxEvent         @relation(fields: [tenantId, outboxEventId], references: [tenantId, id], onDelete: Restrict)
  ledgerEntry       LoyaltyLedgerEntry? @relation(fields: [tenantId, ledgerEntryId], references: [tenantId, id], onDelete: Restrict)
  redemption        Redemption?         @relation(fields: [tenantId, redemptionId], references: [tenantId, id], onDelete: Restrict)
  adjustment        Adjustment?         @relation(fields: [tenantId, adjustmentId], references: [tenantId, id], onDelete: Restrict)

  @@unique([tenantId, outboxEventId])
  @@index([tenantId, status, queuedAt])
  @@index([tenantId, receiptId])
  @@index([tenantId, ledgerEntryId])
  @@index([tenantId, redemptionId])
  @@index([tenantId, adjustmentId])
}

model IdempotencyRecord {
  id             String                  @id @default(uuid())
  tenantId       String
  actorId        String
  endpoint       String
  idempotencyKey String
  requestHash    String
  responseJson   Json?
  status         IdempotencyRecordStatus @default(PENDING)
  expiresAt      DateTime
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt
  tenant         Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@unique([tenantId, actorId, endpoint, idempotencyKey])
  @@index([expiresAt])
}

model AuditLog {
  id            String   @id @default(uuid())
  tenantId      String
  actorId       String?
  actorTenantId String?
  action        String
  entityType    String
  entityId      String?
  requestId     String?
  metadata      Json?
  createdAt     DateTime @default(now())
  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  actor         User?    @relation(fields: [actorTenantId, actorId], references: [tenantId, id], onDelete: SetNull)

  @@index([tenantId, createdAt])
  @@index([actorId, createdAt])
  @@index([actorTenantId, actorId])
}
