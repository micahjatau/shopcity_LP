generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TenantStatus {
  ACTIVE
  SUSPENDED
}

enum BranchStatus {
  ACTIVE
  INACTIVE
}

enum DeviceStatus {
  ACTIVE
  INACTIVE
}

enum UserRole {
  CASHIER
  SUPERVISOR
  ADMIN
  SYSTEM
}

enum UserStatus {
  ACTIVE
  DISABLED
  SUSPENDED
}

enum CustomerStatus {
  ACTIVE
  BLOCKED
}

enum CardStatus {
  ACTIVE
  BLOCKED
  REPLACED
}

enum SessionStatus {
  ACTIVE
  REVOKED
  EXPIRED
}

enum IdempotencyRecordStatus {
  PENDING
  COMPLETED
}

enum ReceiptCaptureStatus {
  CAPTURED
  FLAGGED
  PENDING_APPROVAL
}

model Tenant {
  id        String       @id @default(uuid())
  name      String
  status    TenantStatus @default(ACTIVE)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  branches  Branch[]
  devices   Device[]
  users     User[]
  customers Customer[]
  cards     Card[]
  receipts  Receipt[]
  idempotencyRecords IdempotencyRecord[]
  auditLogs AuditLog[]
}

model Branch {
  id                  String       @id @default(uuid())
  tenantId            String
  name                String
  timezone            String       @default("Africa/Lagos")
  receiptWeekStartDay Int          @default(1)
  status              BranchStatus @default(ACTIVE)
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt
  tenant              Tenant       @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  devices             Device[]
  users               User[]
  customers           Customer[]
  receipts            Receipt[]

  @@unique([tenantId, id])
  @@index([tenantId])
}

model Device {
  id              String       @id @default(uuid())
  tenantId        String
  branchId        String
  name            String
  fingerprintHash String       @unique
  status          DeviceStatus @default(ACTIVE)
  lastSeenAt      DateTime?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  tenant          Tenant       @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  branch          Branch       @relation(fields: [tenantId, branchId], references: [tenantId, id], onDelete: Restrict)
  sessions        Session[]
  receipts        Receipt[]

  @@index([tenantId, branchId])
  @@unique([tenantId, id])
}

model User {
  id                  String     @id @default(uuid())
  tenantId            String
  branchId            String?
  username            String
  supabaseAuthId      String?    @unique
  role                UserRole
  status              UserStatus @default(ACTIVE)
  lastLoginAt         DateTime?
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt
  tenant              Tenant     @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  branch              Branch?    @relation(fields: [tenantId, branchId], references: [tenantId, id], onDelete: Restrict)
  sessions            Session[]
  registeredCustomers Customer[] @relation("CustomerRegisteredBy")
  cardsIssued         Card[]     @relation("CardIssuedBy")
  receiptsCaptured    Receipt[]  @relation("ReceiptCapturedBy")
  receiptsApproved    Receipt[]  @relation("ReceiptApprovedBy")
  auditLogs           AuditLog[]

  @@unique([tenantId, username])
  @@unique([tenantId, id])
  @@index([tenantId, role])
}

model Session {
  id               String        @id @default(uuid())
  userId           String
  deviceId         String?
  sessionTokenHash String        @unique
  csrfTokenHash    String
  status           SessionStatus @default(ACTIVE)
  expiresAt        DateTime
  revokedAt        DateTime?
  lastUsedAt       DateTime?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  user             User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  device           Device?       @relation(fields: [deviceId], references: [id], onDelete: Restrict)

  @@index([userId, status])
  @@index([deviceId])
}

model Customer {
  id                   String         @id @default(uuid())
  tenantId             String
  branchId             String
  fullName             String
  email                String?
  phoneE164            String
  isStaff              Boolean        @default(false)
  status               CustomerStatus @default(ACTIVE)
  registeredBy         String?
  registeredByTenantId String?
  blockedAt            DateTime?
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt
  tenant               Tenant         @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  branch               Branch         @relation(fields: [tenantId, branchId], references: [tenantId, id], onDelete: Restrict)
  registeredByUser     User?          @relation("CustomerRegisteredBy", fields: [registeredByTenantId, registeredBy], references: [tenantId, id], onDelete: SetNull)
  cards                Card[]
  receipts             Receipt[]

  @@unique([tenantId, phoneE164])
  @@unique([tenantId, email])
  @@unique([tenantId, id])
  @@index([tenantId, status])
  @@index([registeredByTenantId, registeredBy])
}

model Card {
  id               String     @id @default(uuid())
  tenantId         String
  customerId       String
  barcodeValue     String
  status           CardStatus @default(ACTIVE)
  issuedBy         String?
  issuedByTenantId String?
  issuedAt         DateTime   @default(now())
  blockedAt        DateTime?
  replacedByCardId String?    @unique
  replacedAt       DateTime?
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt
  tenant           Tenant     @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  customer         Customer   @relation(fields: [tenantId, customerId], references: [tenantId, id], onDelete: Restrict)
  issuedByUser     User?      @relation("CardIssuedBy", fields: [issuedByTenantId, issuedBy], references: [tenantId, id], onDelete: SetNull)
  replacedByCard   Card?      @relation("CardReplacement", fields: [tenantId, replacedByCardId], references: [tenantId, id], onDelete: Restrict)
  replacedCards    Card[]     @relation("CardReplacement")
  receipts         Receipt[]

  @@unique([tenantId, barcodeValue])
  @@unique([tenantId, id])
  @@index([tenantId, customerId, status])
}

model Receipt {
  id                       String   @id @default(uuid())
  tenantId                 String
  branchId                 String
  customerId               String
  cardId                   String
  deviceId                 String?
  posReceiptNumber         String
  normalizedPosReceiptNumber String
  receiptWeekStart         DateTime
  purchaseAmountKobo       BigInt
  occurredAt               DateTime
  capturedByTenantId       String
  capturedBy               String
  captureStatus            ReceiptCaptureStatus @default(CAPTURED)
  approvalReasonCode       String?
  approvedByTenantId       String?
  approvedBy               String?
  approvedAt               DateTime?
  capturedAt               DateTime @default(now())
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt
  tenant                   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  branch                   Branch   @relation(fields: [tenantId, branchId], references: [tenantId, id], onDelete: Restrict)
  customer                 Customer @relation(fields: [tenantId, customerId], references: [tenantId, id], onDelete: Restrict)
  card                     Card     @relation(fields: [tenantId, cardId], references: [tenantId, id], onDelete: Restrict)
  device                   Device?  @relation(fields: [tenantId, deviceId], references: [tenantId, id], onDelete: Restrict)
  capturedByUser           User     @relation("ReceiptCapturedBy", fields: [capturedByTenantId, capturedBy], references: [tenantId, id], onDelete: Restrict)
  approvedByUser           User?    @relation("ReceiptApprovedBy", fields: [approvedByTenantId, approvedBy], references: [tenantId, id], onDelete: SetNull)

  @@unique([tenantId, branchId, receiptWeekStart, normalizedPosReceiptNumber])
  @@unique([tenantId, id])
  @@index([tenantId, branchId, receiptWeekStart])
  @@index([tenantId, cardId, occurredAt])
  @@index([capturedByTenantId, capturedBy])
  @@index([approvedByTenantId, approvedBy])
}

model IdempotencyRecord {
  id             String                 @id @default(uuid())
  tenantId       String
  actorId        String
  endpoint       String
  idempotencyKey String
  requestHash    String
  responseJson   Json?
  status         IdempotencyRecordStatus @default(PENDING)
  expiresAt      DateTime
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt
  tenant         Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@unique([tenantId, actorId, endpoint, idempotencyKey])
  @@index([expiresAt])
}

model AuditLog {
  id            String   @id @default(uuid())
  tenantId      String
  actorId       String?
  actorTenantId String?
  action        String
  entityType    String
  entityId      String?
  requestId     String?
  metadata      Json?
  createdAt     DateTime @default(now())
  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  actor         User?    @relation(fields: [actorTenantId, actorId], references: [tenantId, id], onDelete: SetNull)

  @@index([tenantId, createdAt])
  @@index([actorId, createdAt])
  @@index([actorTenantId, actorId])
}
