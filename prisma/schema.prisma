generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TenantStatus {
  ACTIVE
  SUSPENDED
}

enum BranchStatus {
  ACTIVE
  INACTIVE
}

enum DeviceStatus {
  ACTIVE
  INACTIVE
}

enum UserRole {
  CASHIER
  SUPERVISOR
  ADMIN
  SYSTEM
}

enum UserStatus {
  ACTIVE
  DISABLED
  SUSPENDED
}

enum CustomerStatus {
  ACTIVE
  BLOCKED
}

enum CardStatus {
  ACTIVE
  BLOCKED
  REPLACED
}

enum SessionStatus {
  ACTIVE
  REVOKED
  EXPIRED
}

enum IdempotencyRecordStatus {
  PENDING
  COMPLETED
}

enum ReceiptCaptureStatus {
  CAPTURED
  FLAGGED
  PENDING_APPROVAL
}

enum ReceiptReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

enum LedgerEntryStatus {
  CONFIRMED
}

enum LedgerEntryType {
  EARN
}

enum LedgerEntryDirection {
  CREDIT
}

enum ApprovalStatus {
  PENDING
  APPROVED
  EXECUTED
  REJECTED
  EXPIRED
}

enum OutboxEventStatus {
  PENDING
  QUEUED
  PUBLISHED
  FAILED
}

enum SmsMessageStatus {
  QUEUED
  SENT
  DELIVERED
  FAILED
  SUPPRESSED
}

model Tenant {
  id        String       @id @default(uuid())
  name      String
  status    TenantStatus @default(ACTIVE)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  branches  Branch[]
  devices   Device[]
  users     User[]
  customers Customer[]
  cards     Card[]
  receipts  Receipt[]
  ledgerEntries LoyaltyLedgerEntry[]
  creditLots CreditLot[]
  approvals Approval[]
  outboxEvents OutboxEvent[]
  smsMessages SmsMessage[]
  idempotencyRecords IdempotencyRecord[]
  auditLogs AuditLog[]
}

model Branch {
  id                  String       @id @default(uuid())
  tenantId            String
  name                String
  timezone            String       @default("Africa/Lagos")
  receiptWeekStartDay Int          @default(1)
  status              BranchStatus @default(ACTIVE)
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt
  tenant              Tenant       @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  devices             Device[]
  users               User[]
  customers           Customer[]
  receipts            Receipt[]

  @@unique([tenantId, id])
  @@index([tenantId])
}

model Device {
  id              String       @id @default(uuid())
  tenantId        String
  branchId        String
  name            String
  fingerprintHash String       @unique
  status          DeviceStatus @default(ACTIVE)
  lastSeenAt      DateTime?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  tenant          Tenant       @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  branch          Branch       @relation(fields: [tenantId, branchId], references: [tenantId, id], onDelete: Restrict)
  sessions        Session[]
  receipts        Receipt[]

  @@index([tenantId, branchId])
  @@unique([tenantId, id])
  @@unique([tenantId, branchId, id])
}

model User {
  id                  String     @id @default(uuid())
  tenantId            String
  branchId            String?
  username            String
  supabaseAuthId      String?    @unique
  role                UserRole
  status              UserStatus @default(ACTIVE)
  lastLoginAt         DateTime?
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt
  tenant              Tenant     @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  branch              Branch?    @relation(fields: [tenantId, branchId], references: [tenantId, id], onDelete: Restrict)
  sessions            Session[]
  registeredCustomers Customer[] @relation("CustomerRegisteredBy")
  cardsIssued         Card[]     @relation("CardIssuedBy")
  receiptsCaptured    Receipt[]  @relation("ReceiptCapturedBy")
  receiptsReviewed    Receipt[]  @relation("ReceiptReviewedBy")
  receiptsApproved    Receipt[]  @relation("ReceiptApprovedBy")
  approvalsRequested  Approval[] @relation("ApprovalRequestedBy")
  approvalsDecided    Approval[] @relation("ApprovalDecisionBy")
  ledgerEntriesCreated LoyaltyLedgerEntry[] @relation("LoyaltyLedgerEntryCreatedBy")
  auditLogs           AuditLog[]

  @@unique([tenantId, username])
  @@unique([tenantId, id])
  @@index([tenantId, role])
}

model Session {
  id               String        @id @default(uuid())
  userId           String
  deviceId         String?
  sessionTokenHash String        @unique
  csrfTokenHash    String
  status           SessionStatus @default(ACTIVE)
  expiresAt        DateTime
  revokedAt        DateTime?
  lastUsedAt       DateTime?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  user             User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  device           Device?       @relation(fields: [deviceId], references: [id], onDelete: Restrict)

  @@index([userId, status])
  @@index([deviceId])
}

model Customer {
  id                   String         @id @default(uuid())
  tenantId             String
  branchId             String
  fullName             String
  email                String?
  phoneE164            String
  isStaff              Boolean        @default(false)
  status               CustomerStatus @default(ACTIVE)
  registeredBy         String?
  registeredByTenantId String?
  blockedAt            DateTime?
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt
  tenant               Tenant         @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  branch               Branch         @relation(fields: [tenantId, branchId], references: [tenantId, id], onDelete: Restrict)
  registeredByUser     User?          @relation("CustomerRegisteredBy", fields: [registeredByTenantId, registeredBy], references: [tenantId, id], onDelete: SetNull)
  cards                Card[]
  receipts             Receipt[]
  ledgerEntries        LoyaltyLedgerEntry[]
  creditLots           CreditLot[]

  @@unique([tenantId, phoneE164])
  @@unique([tenantId, email])
  @@unique([tenantId, id])
  @@index([tenantId, status])
  @@index([registeredByTenantId, registeredBy])
}

model Card {
  id               String     @id @default(uuid())
  tenantId         String
  customerId       String
  barcodeValue     String
  status           CardStatus @default(ACTIVE)
  issuedBy         String?
  issuedByTenantId String?
  issuedAt         DateTime   @default(now())
  blockedAt        DateTime?
  replacedByCardId String?    @unique
  replacedAt       DateTime?
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt
  tenant           Tenant     @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  customer         Customer   @relation(fields: [tenantId, customerId], references: [tenantId, id], onDelete: Restrict)
  issuedByUser     User?      @relation("CardIssuedBy", fields: [issuedByTenantId, issuedBy], references: [tenantId, id], onDelete: SetNull)
  replacedByCard   Card?      @relation("CardReplacement", fields: [tenantId, replacedByCardId], references: [tenantId, id], onDelete: Restrict)
  replacedCards    Card[]     @relation("CardReplacement")
  receipts         Receipt[]

  @@unique([tenantId, barcodeValue])
  @@unique([tenantId, id])
  @@index([tenantId, customerId, status])
}

model Receipt {
  id                       String   @id @default(uuid())
  tenantId                 String
  branchId                 String
  customerId               String
  cardId                   String
  deviceId                 String?
  posReceiptNumber         String
  normalizedPosReceiptNumber String
  receiptWeekStart         DateTime
  purchaseAmountKobo       BigInt
  occurredAt               DateTime
  capturedByTenantId       String
  capturedBy               String
  captureStatus            ReceiptCaptureStatus @default(CAPTURED)
  reviewStatus             ReceiptReviewStatus  @default(APPROVED)
  approvalReasonCode       String?
  reviewedAt               DateTime?
  reviewedByTenantId       String?
  reviewedBy               String?
  approvedByTenantId       String?
  approvedBy               String?
  approvedAt               DateTime?
  capturedAt               DateTime @default(now())
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt
  tenant                   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  branch                   Branch   @relation(fields: [tenantId, branchId], references: [tenantId, id], onDelete: Restrict)
  customer                 Customer @relation(fields: [tenantId, customerId], references: [tenantId, id], onDelete: Restrict)
  card                     Card     @relation(fields: [tenantId, cardId], references: [tenantId, id], onDelete: Restrict)
  device                   Device?  @relation(fields: [tenantId, branchId, deviceId], references: [tenantId, branchId, id], onDelete: Restrict)
  capturedByUser           User     @relation("ReceiptCapturedBy", fields: [capturedByTenantId, capturedBy], references: [tenantId, id], onDelete: Restrict)
  reviewedByUser           User?    @relation("ReceiptReviewedBy", fields: [reviewedByTenantId, reviewedBy], references: [tenantId, id], onDelete: SetNull)
  approvedByUser           User?    @relation("ReceiptApprovedBy", fields: [approvedByTenantId, approvedBy], references: [tenantId, id], onDelete: SetNull)
  ledgerEntries            LoyaltyLedgerEntry[]
  approvals                Approval[]
  smsMessages              SmsMessage[]

  @@unique([tenantId, branchId, receiptWeekStart, normalizedPosReceiptNumber])
  @@unique([tenantId, id])
  @@index([tenantId, branchId, receiptWeekStart])
  @@index([tenantId, cardId, occurredAt])
  @@index([capturedByTenantId, capturedBy])
  @@index([reviewedByTenantId, reviewedBy])
  @@index([approvedByTenantId, approvedBy])
}

model LoyaltyLedgerEntry {
  id             String               @id @default(uuid())
  tenantId       String
  customerId     String
  receiptId      String               @unique
  type           LedgerEntryType
  direction      LedgerEntryDirection
  amountKobo     BigInt
  status         LedgerEntryStatus    @default(CONFIRMED)
  correlationId  String               @unique
  reversesEntryId String?              @unique
  createdByTenantId String
  createdBy      String
  effectiveAt    DateTime
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  tenant         Tenant               @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  customer       Customer             @relation(fields: [tenantId, customerId], references: [tenantId, id], onDelete: Restrict)
  receipt        Receipt               @relation(fields: [tenantId, receiptId], references: [tenantId, id], onDelete: Restrict)
  createdByUser  User                  @relation("LoyaltyLedgerEntryCreatedBy", fields: [createdByTenantId, createdBy], references: [tenantId, id], onDelete: Restrict)
  reversesEntry  LoyaltyLedgerEntry?   @relation("LedgerReversal", fields: [tenantId, reversesEntryId], references: [tenantId, id], onDelete: Restrict)
  reversedByEntries LoyaltyLedgerEntry[] @relation("LedgerReversal")
  creditLot      CreditLot?

  @@index([tenantId, customerId, effectiveAt])
  @@index([tenantId, createdAt])
  @@index([createdByTenantId, createdBy])
  @@unique([tenantId, id])
}

model CreditLot {
  id                String      @id @default(uuid())
  tenantId          String
  customerId        String
  earnLedgerEntryId String      @unique
  originalAmountKobo BigInt
  remainingAmountKobo BigInt
  earnedAt          DateTime
  expiresAt         DateTime
  createdAt         DateTime    @default(now())
  tenant            Tenant      @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  customer          Customer    @relation(fields: [tenantId, customerId], references: [tenantId, id], onDelete: Restrict)
  earnLedgerEntry   LoyaltyLedgerEntry @relation(fields: [tenantId, earnLedgerEntryId], references: [tenantId, id], onDelete: Restrict)

  @@index([tenantId, customerId, expiresAt])
  @@unique([tenantId, earnLedgerEntryId])
}

model Approval {
  id                 String         @id @default(uuid())
  tenantId           String
  receiptId          String         @unique
  status             ApprovalStatus @default(PENDING)
  requestedByTenantId String
  requestedBy        String
  reasonCode        String?
  policyVersion     String
  expiresAt         DateTime
  decisionByTenantId String?
  decisionBy         String?
  decisionReason    String?
  requestedAt       DateTime       @default(now())
  decidedAt         DateTime?
  executedAt        DateTime?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  tenant            Tenant         @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  receipt           Receipt        @relation(fields: [tenantId, receiptId], references: [tenantId, id], onDelete: Restrict)
  requestedByUser    User           @relation("ApprovalRequestedBy", fields: [requestedByTenantId, requestedBy], references: [tenantId, id], onDelete: Restrict)
  decisionByUser     User?          @relation("ApprovalDecisionBy", fields: [decisionByTenantId, decisionBy], references: [tenantId, id], onDelete: SetNull)

  @@index([tenantId, status, requestedAt])
  @@index([requestedByTenantId, requestedBy])
  @@index([decisionByTenantId, decisionBy])
}

model OutboxEvent {
  id            String            @id @default(uuid())
  tenantId      String
  aggregateType String
  aggregateId   String
  eventType     String
  payload       Json
  status        OutboxEventStatus @default(PENDING)
  attempts      Int               @default(0)
  nextAttemptAt DateTime?
  publishedAt   DateTime?
  deadLetteredAt DateTime?
  failureCategory String?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  tenant        Tenant            @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  smsMessage    SmsMessage?

  @@unique([tenantId, id])
  @@index([tenantId, status, nextAttemptAt])
}

model SmsMessage {
  id               String           @id @default(uuid())
  tenantId         String
  receiptId        String
  outboxEventId    String
  phoneE164        String
  template         String
  payload          Json
  status           SmsMessageStatus @default(QUEUED)
  attempts         Int              @default(0)
  providerMessageId String?
  lastError        String?
  queuedAt         DateTime         @default(now())
  lastAttemptAt    DateTime?
  nextAttemptAt    DateTime?
  deadLetteredAt   DateTime?
  failureCategory  String?
  sentAt           DateTime?
  deliveredAt      DateTime?
  failedAt         DateTime?
  suppressedAt     DateTime?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  tenant           Tenant           @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  receipt          Receipt          @relation(fields: [tenantId, receiptId], references: [tenantId, id], onDelete: Restrict)
  outboxEvent      OutboxEvent      @relation(fields: [tenantId, outboxEventId], references: [tenantId, id], onDelete: Restrict)

  @@unique([tenantId, receiptId])
  @@unique([tenantId, outboxEventId])
  @@index([tenantId, status, queuedAt])
}

model IdempotencyRecord {
  id             String                 @id @default(uuid())
  tenantId       String
  actorId        String
  endpoint       String
  idempotencyKey String
  requestHash    String
  responseJson   Json?
  status         IdempotencyRecordStatus @default(PENDING)
  expiresAt      DateTime
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt
  tenant         Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@unique([tenantId, actorId, endpoint, idempotencyKey])
  @@index([expiresAt])
}

model AuditLog {
  id            String   @id @default(uuid())
  tenantId      String
  actorId       String?
  actorTenantId String?
  action        String
  entityType    String
  entityId      String?
  requestId     String?
  metadata      Json?
  createdAt     DateTime @default(now())
  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  actor         User?    @relation(fields: [actorTenantId, actorId], references: [tenantId, id], onDelete: SetNull)

  @@index([tenantId, createdAt])
  @@index([actorId, createdAt])
  @@index([actorTenantId, actorId])
}
