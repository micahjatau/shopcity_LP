{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://shopcity.local/docs/release-evidence/sprint-5-pilot/readiness.schema.json",
  "title": "Sprint 5 pilot readiness evidence",
  "type": "object",
  "required": [
    "schemaVersion",
    "releaseSha",
    "imageDigest",
    "releaseCandidate",
    "gates",
    "approvals",
    "trainingSignOffs"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1"
    },
    "releaseSha": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{40}$"
    },
    "imageDigest": {
      "type": "string",
      "pattern": ".+@sha256:[0-9a-fA-F]{64}$"
    },
    "releaseCandidate": {
      "type": "object",
      "required": [
        "engineeringComplete",
        "stagingCertified",
        "productionApproved",
        "pilotStarted"
      ],
      "properties": {
        "engineeringComplete": { "type": "boolean" },
        "stagingCertified": { "type": "boolean" },
        "productionApproved": { "type": "boolean" },
        "pilotStarted": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "gates": {
      "type": "object",
      "required": [
        "dockerVerification",
        "security",
        "performance",
        "restore",
        "staging",
        "training",
        "signOff"
      ],
      "additionalProperties": {
        "$ref": "#/$defs/gate"
      }
    },
    "approvals": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/approval"
      }
    },
    "trainingSignOffs": {
      "type": "array",
      "minItems": 3,
      "items": {
        "$ref": "#/$defs/trainingSignOff"
      }
    }
  },
  "$defs": {
    "gate": {
      "type": "object",
      "required": ["status", "recordedAt", "evidence"],
      "properties": {
        "status": {
          "type": "string",
          "enum": ["passed", "failed", "missing"]
        },
        "recordedAt": {
          "type": "string",
          "format": "date-time"
        },
        "evidence": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "approval": {
      "type": "object",
      "required": ["role", "name", "approvedAt"],
      "properties": {
        "role": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "approvedAt": { "type": "string", "format": "date-time" }
      },
      "additionalProperties": false
    },
    "trainingSignOff": {
      "type": "object",
      "required": ["role", "reference", "completedAt"],
      "properties": {
        "role": { "type": "string", "minLength": 1 },
        "reference": { "type": "string", "minLength": 1 },
        "completedAt": { "type": "string", "format": "date-time" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
