{
  "name": "shopcity-lp",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.{ts,js,mjs,cjs}\" \"test/**/*.{ts,js,mjs,cjs}\" \"scripts/**/*.{ts,js,mjs,cjs}\" \"docs/**/*.{md,json,yml,yaml}\" \"openspec/**/*.{md,yml,yaml}\" \".github/workflows/**/*.{yml,yaml}\" \"*.{md,json,yml,yaml}\"",
    "format:check": "prettier --check \"src/**/*.{ts,js,mjs,cjs}\" \"test/**/*.{ts,js,mjs,cjs}\" \"scripts/**/*.{ts,js,mjs,cjs}\" \"docs/**/*.{md,json,yml,yaml}\" \"openspec/**/*.{md,yml,yaml}\" \".github/workflows/**/*.{yml,yaml}\" \"*.{md,json,yml,yaml}\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/src/main.js",
    "start:worker": "ts-node -r tsconfig-paths/register src/worker.ts",
    "start:worker:prod": "node dist/src/worker.js",
    "verify:prod-entrypoints": "test -f dist/src/main.js && test -f dist/src/worker.js && node dist/src/worker.js --help",
    "architecture:check": "depcruise --config dependency-cruiser.config.cjs src",
    "gitnexus:analyze": "node scripts/gitnexus.cjs analyze .",
    "proposal:impact": "node scripts/gitnexus.cjs impact -r shopcity_LP --summary-only --include-tests",
    "gitnexus:smoke": "node scripts/gitnexus.cjs --help",
    "lint:src": "NODE_OPTIONS=--max-old-space-size=4096 eslint \"src/*.ts\" && NODE_OPTIONS=--max-old-space-size=4096 eslint \"src/common/**/*.ts\" && NODE_OPTIONS=--max-old-space-size=4096 eslint \"src/config/**/*.ts\" && NODE_OPTIONS=--max-old-space-size=4096 eslint \"src/database/**/*.ts\" && NODE_OPTIONS=--max-old-space-size=4096 eslint \"src/jobs/**/*.ts\" && NODE_OPTIONS=--max-old-space-size=4096 eslint \"src/modules/**/*.ts\" && NODE_OPTIONS=--max-old-space-size=4096 eslint \"src/supabase/**/*.ts\"",
    "lint:test": "NODE_OPTIONS=--max-old-space-size=4096 eslint \"test/**/*.e2e-spec.ts\" && NODE_OPTIONS=--max-old-space-size=4096 eslint \"test/**/*.int-spec.ts\" && NODE_OPTIONS=--max-old-space-size=4096 eslint \"test/support/**/*.ts\"",
    "lint": "npm run lint:src && npm run lint:test",
    "lint:fix": "npm run lint:src -- --fix && npm run lint:test -- --fix",
    "verify:fast": "NODE_OPTIONS=--max-old-space-size=4096 prettier --check \"src/**/*.{ts,js,mjs,cjs}\" \"test/**/*.{ts,js,mjs,cjs}\" \"scripts/**/*.{ts,js,mjs,cjs}\" \"docs/**/*.{md,json,yml,yaml}\" \"openspec/**/*.{md,yml,yaml}\" \".github/workflows/**/*.{yml,yaml}\" \"*.{md,json,yml,yaml}\" && npm run lint && npm run typecheck && npm run build && npm run verify:prod-entrypoints",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "prisma:generate": "DATABASE_URL=${DATABASE_URL:-postgresql://shopcity:shopcity@127.0.0.1:5432/shopcity_test?schema=public} prisma generate",
    "prisma:validate": "DATABASE_URL=${DATABASE_URL:-postgresql://shopcity:shopcity@127.0.0.1:5432/shopcity_test?schema=public} prisma validate",
    "prisma:seed": "ts-node prisma/seed.ts",
    "openapi:export": "node -r ts-node/register -r tsconfig-paths/register scripts/export-openapi.ts",
    "openapi:lint": "npm run openapi:export && spectral lint docs/api/openapi.json",
    "openapi:diff": "npm run openapi:export && oasdiff diff docs/api/openapi.base.json docs/api/openapi.json",
    "client:generate": "orval --input docs/api/openapi.json --output client/shopcity-client.ts --client fetch --mode single --prettier",
    "client:typecheck": "tsc --noEmit -p tsconfig.client.json",
    "openspec:validate": "openspec validate --changes",
    "test:coverage:critical": "jest --coverage --runInBand",
    "format:release": "prettier --check \"docs/database/migration-tracker.md\" \"docs/api/sprint-3-financial-contract-draft.md\" \"docs/runbooks/sms-failure.md\" \"openspec/changes/repo-review-34/tasks.md\"",
    "verify:sql-runbooks": "jest test/receipt-quarantine-sql.int-spec.ts --config ./test/jest-int.json --runInBand",
    "verify:release-artifacts": "npm run format:release && npm run verify:sql-runbooks",
    "validate:scope": "node scripts/validation-scope.cjs",
    "bruno:test": "cd bruno && bru run -r --tests-only --env-var baseUrl=${BRUNO_BASE_URL:-http://127.0.0.1:3000}",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "test:integration:prime": "node ./scripts/prime-testcontainers.cjs",
    "test:integration": "jest --config ./test/jest-int.json --runInBand",
    "prepare": "husky"
  },
  "dependencies": {
    "@fastify/helmet": "^13.1.0",
    "@nestjs/common": "^11.0.1",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.0.1",
    "@nestjs/platform-fastify": "^11.1.28",
    "@nestjs/swagger": "^11.4.6",
    "@nestjs/terminus": "^11.1.1",
    "@prisma/client": "^6.19.3",
    "@supabase/supabase-js": "^2.110.7",
    "bullmq": "^5.80.10",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "fastify": "^5.10.0",
    "joi": "^18.2.3",
    "nestjs-pino": "^4.6.1",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "pino-pretty": "^13.1.3",
    "redis": "^6.1.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@compodoc/compodoc": "^2.0.0",
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.18.0",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@oasdiff-js/oasdiff-js": "^1.0.0",
    "@stoplight/spectral-cli": "^6.16.1",
    "@testcontainers/postgresql": "^12.0.4",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.0.0",
    "@types/supertest": "^7.0.0",
    "@usebruno/cli": "^3.2.0",
    "gitnexus": "1.6.9",
    "dependency-cruiser": "^18.1.0",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "globals": "^17.0.0",
    "husky": "^9.1.7",
    "install": "^0.13.0",
    "jest": "^30.0.0",
    "lint-staged": "^17.1.0",
    "orval": "^7.11.2",
    "prettier": "^3.4.2",
    "prisma": "^6.19.3",
    "source-map-support": "^0.5.21",
    "supabase": "^2.109.1",
    "supertest": "^7.0.0",
    "testcontainers": "^12.0.4",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageThreshold": {
      "src/modules/redemptions/redemptions.service.ts": {
        "branches": 55
      },
      "src/modules/approvals/approvals.service.ts": {
        "branches": 15
      },
      "src/common/balance/lot-allocation.service.ts": {
        "branches": 80
      },
      "src/jobs/outbox-worker.runtime.ts": {
        "branches": 40
      }
    },
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  }
}
