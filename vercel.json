{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "env": {
    "SHOPCITY_TIMEZONE": "Africa/Lagos",
    "RECEIPT_WEEK_START_DAY": "1",
    "LOG_LEVEL": "info",
    "SWAGGER_ENABLED": "false"
  },
  "builds": [
    {
      "src": "api/index.ts",
      "use": "@vercel/node"
    }
  ],
  "crons": [
    {
      "path": "/api/v1/cron/report-materialization",
      "schedule": "0 0 * * *"
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "/api/index.ts"
    }
  ]
}
