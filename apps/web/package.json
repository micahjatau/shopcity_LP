{
  "name": "@shopcity/web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "npm run tokens:generate && next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "npm run tokens:check && npm run design-system:test && jest --config ./jest.web.config.cjs --runInBand",
    "unit:test": "jest --config ./jest.web.config.cjs --runInBand",
    "a11y:test": "jest --config ./jest.a11y.config.cjs --runInBand",
    "a11y:browser": "playwright test --config ./playwright.config.ts tests/browser-a11y.spec.ts",
    "critical:test": "playwright test --config ./playwright.config.ts --grep @critical",
    "critical:update": "playwright test --config ./playwright.config.ts --grep @critical --update-snapshots",
    "visual:workflow:test": "PLAYWRIGHT_USE_PRODUCTION_SERVER=false playwright test --config ./playwright.visual-workflows.config.ts --grep-invert @critical",
    "visual:workflow:update": "PLAYWRIGHT_USE_PRODUCTION_SERVER=false playwright test --config ./playwright.visual-workflows.config.ts --grep-invert @critical --update-snapshots",
    "visual:production:build": "SHOPCITY_WEB_DIST_DIR=.next-playwright-production NEXT_PUBLIC_DEV_CASHIER_TEST_SESSION_ENABLED=false NEXT_PUBLIC_SHOPCITY_LEGACY_DEVICE_AUTH_ENABLED=false npm run build",
    "visual:production:test": "SHOPCITY_WEB_DIST_DIR=.next-playwright-production NEXT_PUBLIC_DEV_CASHIER_TEST_SESSION_ENABLED=false NEXT_PUBLIC_SHOPCITY_LEGACY_DEVICE_AUTH_ENABLED=false PLAYWRIGHT_USE_PRODUCTION_SERVER=true playwright test --config ./playwright.config.ts tests/visual-regression.spec.ts",
    "visual:production:update": "SHOPCITY_WEB_DIST_DIR=.next-playwright-production NEXT_PUBLIC_DEV_CASHIER_TEST_SESSION_ENABLED=false NEXT_PUBLIC_SHOPCITY_LEGACY_DEVICE_AUTH_ENABLED=false PLAYWRIGHT_USE_PRODUCTION_SERVER=true playwright test --config ./playwright.config.ts tests/visual-regression.spec.ts --update-snapshots",
    "visual:test": "npm run visual:workflow:test && npm run visual:production:build && npm run visual:production:test",
    "visual:update": "npm run visual:workflow:update && npm run visual:production:build && npm run visual:production:update",
    "conformance:test": "playwright test --config ./playwright.config.ts tests/workflow-routes.spec.ts -g 'overview|visually paired|prototype landmarks|transaction detail|Sync Queue controls'",
    "live:test": "node ../../scripts/e2e/assert-disposable-target.cjs && playwright test --config ./playwright.config.ts tests/live-backend-e2e.spec.ts --timeout=240000 --workers=1 --retries=0",
    "smoke:test": "playwright test --config ./playwright.smoke.config.ts",
    "smoke:cashier": "playwright test --config ./playwright.smoke.config.ts tests/smoke/roles/cashier.smoke.spec.ts",
    "smoke:production": "SMOKE_ENVIRONMENT=production playwright test --config ./playwright.smoke.config.ts",
    "tokens:generate": "node ./scripts/generate-tokens.mjs",
    "tokens:check": "node ./scripts/check-token-drift.mjs",
    "design-system:check": "node ./scripts/check-cashier-style-ownership.mjs",
    "design-system:test": "node --test ./scripts/check-cashier-style-ownership.spec.mjs ./scripts/token-validation.spec.mjs"
  },
  "dependencies": {
    "@migov/digital-guidelines-core": "^5.5.0",
    "@migov/digital-guidelines-core-react": "^5.5.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "framer-motion": "^14.0.0",
    "lucide-react": "^1.46.0",
    "next": "^15.4.6",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tailwind-merge": "^3.7.0"
  },
  "overrides": {
    "postcss": "^8.5.28",
    "sharp": "^0.35.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@swc/core": "^1.15.47",
    "@swc/jest": "^0.2.39",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.4",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.7",
    "@types/react-dom": "^19.0.3",
    "axe-core": "^4.13.0",
    "eslint": "^9.18.0",
    "eslint-config-next": "^15.4.6",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "jest-environment-jsdom": "^30.4.1",
    "jsdom": "^29.1.1",
    "shadcn": "^4.21.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.7.3"
  }
}
