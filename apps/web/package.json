{
  "name": "@shopcity/web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "npm run tokens:generate && next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "npm run tokens:check",
    "a11y:test": "jest --config ./jest.a11y.config.cjs --runInBand",
    "tokens:generate": "node ./scripts/generate-tokens.mjs",
    "tokens:check": "node ./scripts/check-token-drift.mjs"
  },
  "dependencies": {
    "next": "^15.4.6",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@swc/core": "^1.15.47",
    "@swc/jest": "^0.2.39",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.4",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.7",
    "@types/react-dom": "^19.0.3",
    "axe-core": "^4.13.0",
    "eslint": "^9.18.0",
    "eslint-config-next": "^15.4.6",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "jest-environment-jsdom": "^30.4.1",
    "jsdom": "^29.1.1",
    "typescript": "^5.7.3"
  }
}
