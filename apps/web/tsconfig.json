{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["dom", "dom.iterable", "es2022"],
    "allowJs": false,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "baseUrl": ".",
    "paths": {
      "@/app/*": ["app/*"],
      "@/components/*": ["components/*"],
      "@/lib/*": ["lib/*"],
      "@/styles/*": ["styles/*"]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".next-a11y-fix/types/**/*.ts",
    ".next-ci-fix/types/**/*.ts",
    ".next-ci-fix2/types/**/*.ts",
    ".next-ci-fix3/types/**/*.ts",
    ".next-ci-fix4/types/**/*.ts",
    ".next-ci-fix5/types/**/*.ts",
    ".next-dev/types/**/*.ts",
    ".next-mobile-menu-check/types/**/*.ts",
    ".next-playwright-dev/types/**/*.ts",
    ".next/types/**/*.ts",
    "next-env.d.ts"
  ],
  "exclude": ["node_modules", "tests/**/*.ts", "tests/**/*.tsx"]
}
