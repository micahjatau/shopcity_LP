meta {
  name: Health Ready
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/health/ready
}

tests {
  test("returns 200", function() {
    expect(res.getStatus()).to.equal(200);
  });

  test("returns ok status", function() {
    const body = res.getBody();
    expect(body.data.status).to.equal("ok");
  });
}
