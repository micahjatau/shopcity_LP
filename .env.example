NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://shopcity:shopcity@localhost:5432/shopcity?schema=public
REDIS_URL=redis://localhost:6379
SESSION_SECRET=replace-me-with-a-long-random-secret
CSRF_SECRET=replace-me-with-a-long-random-secret
SHOPCITY_TIMEZONE=Africa/Lagos
RECEIPT_WEEK_START_DAY=1
DEFAULT_EARN_RATE_BPS=200
MIN_REDEMPTION_KOBO=50000
PURCHASE_FLAG_THRESHOLD_KOBO=10000000
PURCHASE_APPROVAL_THRESHOLD_KOBO=20000000
REDEMPTION_APPROVAL_THRESHOLD_KOBO=500000
LOG_LEVEL=info
SWAGGER_ENABLED=false
DEFAULT_PUBLIC_TENANT_ID=00000000-0000-0000-0000-000000000001
DEFAULT_PUBLIC_BRANCH_ID=00000000-0000-0000-0000-000000000002
CORS_ORIGIN_ALLOWLIST=http://localhost:3000,http://127.0.0.1:3000
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=replace-me
SUPABASE_SERVICE_ROLE_KEY=replace-me
# Bootstrap seeding requires a real non-placeholder admin password outside tests.
DEFAULT_ADMIN_PASSWORD=replace-me-with-a-strong-password
