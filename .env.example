NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://shopcity:shopcity@localhost:5432/shopcity?schema=public
REDIS_URL=redis://localhost:6379
SESSION_SECRET=replace-me-with-a-long-random-secret
CSRF_SECRET=replace-me-with-a-long-random-secret
DEVICE_ATTESTATION_KEK=replace-me-with-a-long-random-secret-replace-me
# Generate 32 random bytes and encode as unpadded base64url; configure from approved secret storage.
# Required before pairing/authenticating DEVICE_TOKEN devices; never reuse SESSION_SECRET or CSRF_SECRET.
POS_DEVICE_TOKEN_HMAC_KEY_VERSION=1
POS_DEVICE_TOKEN_HMAC_KEY=
# Optional exact browser origins allowed only for POS token pairing (does not change CORS).
POS_DEVICE_TOKEN_PAIRING_ORIGINS=
WEBAUTHN_RP_ID=localhost
WEBAUTHN_ALLOWED_ORIGINS=http://localhost:3000
WEBAUTHN_DEVICE_QUALIFICATION_APPROVED=false
# Local development only; cannot be enabled in test, staging, or production.
WEBAUTHN_DEV_ENROLLMENT_ENABLED=false
# Default-off local cashier workflow session; requires NODE_ENV=development,
# no VERCEL_ENV, loopback DATABASE_URL, and deterministic SMS mode.
DEV_CASHIER_TEST_SESSION_ENABLED=false
# Optional exact HTTPS Tailscale Serve origin; only with the local cashier opt-in and tailnet-only access.
# DEV_CASHIER_TEST_SESSION_TAILSCALE_ORIGIN=https://your-device.your-tailnet.ts.net:8445
# Vercel Preview only; requires VERCEL_ENV=preview and a non-production API/database.
WEBAUTHN_PREVIEW_ENROLLMENT_ENABLED=false
SHOPCITY_TIMEZONE=Africa/Lagos
RECEIPT_WEEK_START_DAY=1
DEFAULT_EARN_RATE_BPS=200
MIN_REDEMPTION_KOBO=50000
PURCHASE_FLAG_THRESHOLD_KOBO=10000000
PURCHASE_APPROVAL_THRESHOLD_KOBO=20000000
PURCHASE_AMOUNT_CEILING_KOBO=100000000
REDEMPTION_APPROVAL_THRESHOLD_KOBO=500000
OUTBOX_PUBLISH_BATCH_SIZE=25
OUTBOX_PUBLISH_INTERVAL_MS=5000
OUTBOX_RETRY_DELAY_MS=30000
OUTBOX_RECOVERY_THRESHOLD_MS=60000
SMS_DLR_POLL_INTERVAL_MS=300000
SMS_DLR_POLL_BATCH_SIZE=10
SMS_PROVIDER_MODE=deterministic
# ebulksms remains the default; select arkesel only when configuring its own credentials.
SMS_PROVIDER_VENDOR=ebulksms
SMS_PROVIDER_URL=https://api.ebulksms.com:8443/sendsms.json
SMS_PROVIDER_USERNAME=replace-me
SMS_PROVIDER_API_KEY=replace-me
SMS_PROVIDER_SENDER_ID=ShopCity
# Africa's Talking standard SMS settings are required only for
# SMS_PROVIDER_MODE=real and SMS_PROVIDER_VENDOR=africastalking.
# The live username/API key and sender ID are required for live use.
# The sandbox always uses username `sandbox` and its separate API key.
# Do not commit or log provider credentials.
# AFRICASTALKING_LIVE_USERNAME=shopcity
# AFRICASTALKING_LIVE_API_KEY=
# AFRICASTALKING_SENDER_ID=ShopCity
# AFRICASTALKING_SANDBOX_API_KEY=
AFRICASTALKING_SANDBOX=false
# Twilio Programmable Messaging requires SMS_PROVIDER_MODE=real and
# SMS_PROVIDER_VENDOR=twilio. Replace these placeholders locally; never commit secrets.
# Use API Key SID + Secret with Account SID. Configure exactly one sender below.
# Trial sends can reach verified recipients; do not use as a no-delivery sandbox.
# TWILIO_ACCOUNT_SID=AC<32-hex-characters>
# TWILIO_API_KEY=SK<32-hex-characters>
# TWILIO_API_SECRET=<API-key-secret>
# TWILIO_FROM_NUMBER=+<country-code-and-number>
# TWILIO_MESSAGING_SERVICE_SID=MG<32-hex-characters>
#
# Arkesel settings are required only for SMS_PROVIDER_MODE=real and SMS_PROVIDER_VENDOR=arkesel.
# Store credentials in a secret manager; do not commit or log them.
# ARKESEL_API_KEY=
# ARKESEL_SENDER_ID=ShopCity
ARKESEL_API_URL=https://sms.arkesel.com/api/v2
# Non-production only; sandbox requests are not billed or delivered to mobile networks.
ARKESEL_SANDBOX=false
SMS_PROVIDER_TIMEOUT_MS=10000
ALLOW_FAKE_SMS_IN_PRODUCTION=false
LOG_LEVEL=info
SWAGGER_ENABLED=false
DEFAULT_PUBLIC_TENANT_ID=00000000-0000-4000-8000-000000000001
DEFAULT_PUBLIC_BRANCH_ID=00000000-0000-4000-8000-000000000002
CORS_ORIGIN_ALLOWLIST=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3100,http://127.0.0.1:3100
# Local BFF identity is optional; deployments require the same generated secret
# in the API and web runtime, stored separately from session/CSRF secrets.
SHOPCITY_DEPLOYMENT_ENV=local
SHOPCITY_BFF_SHARED_SECRET=
PILOT_CASHIER_DEVICE_TOKEN_ONLY=false
SHOPCITY_WEB_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3100,http://127.0.0.1:3100
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=replace-me
SUPABASE_SERVICE_ROLE_KEY=replace-me
# Bootstrap seeding requires a real non-placeholder admin password outside tests.
DEFAULT_ADMIN_PASSWORD=replace-me-with-a-strong-password

# Optional frontend settings for apps/web
NEXT_PUBLIC_DEV_CASHIER_TEST_SESSION_ENABLED=false
SHOPCITY_LIVE_E2E=0
SHOPCITY_BACKEND_URL=http://127.0.0.1:3000
SHOPCITY_LIVE_ADMIN_USERNAME=admin@shopcity.local
SHOPCITY_LIVE_CASHIER_USERNAME=cashier-live@shopcity.local
SHOPCITY_LIVE_SUPERVISOR_USERNAME=supervisor-live@shopcity.local
